<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YotoLabels.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="Commands"
            Margin="8,0,8,0"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton Click="OnNew" Label="New" ToolTipService.ToolTip="New sheet (Ctrl+N)">
                <AppBarButton.Icon><SymbolIcon Symbol="Page2" /></AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Click="OnOpen" Label="Open" ToolTipService.ToolTip="Open a saved sheet (Ctrl+O)">
                <AppBarButton.Icon><SymbolIcon Symbol="OpenFile" /></AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Click="OnSave" Label="Save" ToolTipService.ToolTip="Save (Ctrl+S)">
                <AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Click="OnSaveAs" Label="Save as" ToolTipService.ToolTip="Save as (Ctrl+Shift+S)">
                <AppBarButton.Icon><SymbolIcon Symbol="SaveLocal" /></AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Click="OnAddImages" Label="Add images" ToolTipService.ToolTip="Fill empty labels with pictures">
                <AppBarButton.Icon><SymbolIcon Symbol="Pictures" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Click="OnClearAll" Label="Clear all" ToolTipService.ToolTip="Remove every picture and title">
                <AppBarButton.Icon><SymbolIcon Symbol="Clear" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="PrintButton" Click="OnPrint" Label="Print" ToolTipService.ToolTip="Print or save as PDF (Ctrl+P)">
                <AppBarButton.Icon><SymbolIcon Symbol="Print" /></AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="P" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Sheet preview -->
            <Border
                Margin="16,4,8,16"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Viewbox Margin="24" Stretch="Uniform" StretchDirection="Both">
                    <Border
                        x:Name="PageFrame"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" />
                </Viewbox>
            </Border>

            <!-- Inspector -->
            <ScrollViewer Grid.Column="1" Padding="8,0,16,16" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SelectedHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="No label selected" />
                            <TextBlock x:Name="SelectedHint" Style="{StaticResource Hint}" Text="Click a label on the sheet. Scroll on a picture to zoom, drag it to move, double-click to replace." />
                            <StackPanel x:Name="SelectedPanel" Spacing="8" Margin="0,8,0,0">
                                <TextBox
                                    x:Name="TitleBox"
                                    Header="Title"
                                    AcceptsReturn="True"
                                    PlaceholderText="Album or story name"
                                    TextChanged="OnTitleChanged"
                                    TextWrapping="Wrap" />
                                <Slider
                                    x:Name="ZoomSlider"
                                    Header="Zoom"
                                    Maximum="800"
                                    Minimum="20"
                                    StepFrequency="1"
                                    ValueChanged="OnZoomSliderChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="OnReplaceImage" Content="Replace image" />
                                    <Button Click="OnResetPosition" Content="Reset" ToolTipService.ToolTip="Reset zoom and position" />
                                    <Button Click="OnRemoveImage" Content="Remove" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Sheet" />
                            <TextBlock x:Name="SheetName" Style="{StaticResource Hint}" />
                            <RadioButtons x:Name="LayoutChoice" Header="Card layout" Margin="0,8,0,0" SelectionChanged="OnLayoutChanged">
                                <x:String>Square picture + title</x:String>
                                <x:String>Picture fills the card</x:String>
                            </RadioButtons>
                            <NumberBox
                                x:Name="TitleSizeBox"
                                Header="Title size (pt)"
                                Margin="0,8,0,0"
                                Maximum="28"
                                Minimum="6"
                                SmallChange="0.5"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnTitleSizeChanged" />
                            <ToggleSwitch x:Name="RoundedToggle" Header="Rounded corners" Toggled="OnRoundedToggled" />
                            <ToggleSwitch x:Name="CutLineToggle" Header="Print cut line" Toggled="OnCutLineToggled" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Printer calibration" />
                            <TextBlock Style="{StaticResource Hint}" Text="Print a test page on plain paper and hold it against a label sheet. If it is off, shift everything here. Positive values move right and down." />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="OffsetXBox"
                                    Header="Offset X (mm)"
                                    Maximum="10"
                                    Minimum="-10"
                                    SmallChange="0.5"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="OnOffsetChanged" />
                                <NumberBox
                                    x:Name="OffsetYBox"
                                    Grid.Column="1"
                                    Header="Offset Y (mm)"
                                    Maximum="10"
                                    Minimum="-10"
                                    SmallChange="0.5"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="OnOffsetChanged" />
                            </Grid>
                            <Button Click="OnPrintTestPage" Content="Print test page" />
                        </StackPanel>
                    </Border>

                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational"
                        Title="Printing"
                        Message="Use Letter paper. To get a PDF, pick Microsoft Print to PDF as the printer. Trim each label at the dashed line so it fits a Yoto card." />

                    <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" Title="Something went wrong" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
